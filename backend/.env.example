# Copy to backend/.env and fill in what you have. Everything is optional:
# with no keys, shopr searches the Shopify shops listed in Setup.

# eBay Browse API (https://developer.ebay.com/my/keys, production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_US
# EBAY_CATEGORY_IDS=1059,93427,4250   # Men's clothing, shoes, accessories (one per search)
# EBAY_CAMPAIGN_ID=                   # eBay Partner Network campaign, for affiliate links

# Etsy Open API v3 (https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Claude writes better search queries from your moodboard (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# SHOPR_CLAUDE_MODEL=claude-opus-5-5

# Require this token from the app. Set it whenever the server is reachable from the internet (tunnels).
SHOPR_TOKEN=

# Photos analyzed per search (the rest are picked up on later searches)
# SHOPR_EMBED_BUDGET=2500
